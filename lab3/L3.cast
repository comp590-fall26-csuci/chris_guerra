[5621.054471, "o", "cat fibonacci.c"]
[5621.719352, "o", "\r\n\u001b[?2004l\r\u001b]133;C\u001b\\\r\u001b]666;vte.shell.preexec!\u001b\\"]
[5621.723205, "o", "#include <math.h>\r\n#include \"fibonacci.h\"\r\n\r\nint fibonacci(int n) {\r\n    if (n <= 0) return 0;\r\n    if (n == 1) return 1;\r\n    return fibonacci(n - 1) + fibonacci(n - 2);\r\n}\r\n\r\n/* Uses the square root function to calculate an analytical approximation */\r\ndouble golden_ratio_approx(int n) {\r\n    double phi = (1.0 + sqrt(5.0)) / 2.0;\r\n    return phi;\r\n}\r\n"]
[5621.723758, "o", "\u001b]666;vte.shell.postexec=0\u001b\\"]
