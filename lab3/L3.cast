[6262.890898, "o", "#include <stdio.h>\r\n#include \"fibonacci.h\"\r\n\r\nint main(void) {\r\n    int term = 10;\r\n    printf(\"The %dth Fibonacci number is %d\\n\", term, fibonacci(term));\r\n    printf(\"The theoretical Golden Ratio is %f\\n\", golden_ratio_approx(term));\r\n    return 0;\r\n}\r\n"]
[6262.891701, "o", "\u001b]666;vte.shell.postexec=0\u001b\\"]
[6262.894717, "o", "\u001b]7;file://Ubuntu/home/cguerra/repos/comp590/chris_guerra/lab3/590MakefileLab\u001b\\\u001b]0;cguerra@Ubuntu:~/repos/comp590/chris_guerra/lab3/590MakefileLab\u001b\\\u001b]666;vte.shell.precmd!\u001b\\"]
