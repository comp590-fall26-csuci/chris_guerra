[6263.681143, "o", "c"]
[6263.741065, "o", "a"]
[6263.919517, "o", "t"]
[6264.075917, "o", " "]
[6264.804682, "o", "f"]
[6265.063504, "o", "i"]
[6265.586073, "o", "b"]
[6265.93568, "o", "onacci.c "]
[6266.960523, "o", "\r\n\u001b[?2004l\r\u001b]133;C\u001b\\\r\u001b]666;vte.shell.preexec!\u001b\\"]
[6266.966189, "o", "#include <math.h>\r\n#include \"fibonacci.h\"\r\n\r\nint fibonacci(int n) {\r\n    if (n <= 0) return 0;\r\n    if (n == 1) return 1;\r\n    return fibonacci(n - 1) + fibonacci(n - 2);\r\n}\r\n\r\n/* Uses the square root function to calculate an analytical approximation */\r\ndouble golden_ratio_approx(int n) {\r\n    double phi = (1.0 + sqrt(5.0)) / 2.0;\r\n    return phi;\r\n}\r\n"]
[6266.967077, "o", "\u001b]666;vte.shell.postexec=0\u001b\\"]
